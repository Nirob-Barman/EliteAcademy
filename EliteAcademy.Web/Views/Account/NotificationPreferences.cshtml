@model EliteAcademy.Web.ViewModels.Account.NotificationPreferencesViewModel

@{
    ViewData["Title"] = "Notification Preferences";
    Layout = "~/Views/Shared/Account/_AccountSettingsLayout.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-dark text-white fw-semibold d-flex align-items-center gap-2">
        <i class="fas fa-bell"></i> Notification Preferences
    </div>
    <div class="card-body p-4">

        <p class="text-muted small mb-4">
            Choose which notifications you want to receive. Changes take effect immediately.
        </p>

        <form asp-action="NotificationPreferences" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            @* ── Email notifications ─────────────────────────────── *@
            <h6 class="fw-semibold text-uppercase text-muted small mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-envelope fa-sm"></i> Email Notifications
            </h6>

            <div class="d-flex flex-column gap-3 mb-4 ps-1">

                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="fw-medium small">Enrollment Confirmed</div>
                        <div class="text-muted" style="font-size:.8rem;">Receive an email when you successfully enroll in a class.</div>
                    </div>
                    <div class="form-check form-switch ms-3 flex-shrink-0 mt-1">
                        <input asp-for="EmailOnEnrollment" class="form-check-input" role="switch" />
                    </div>
                </div>

                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="fw-medium small">Class Announcements</div>
                        <div class="text-muted" style="font-size:.8rem;">Receive an email when an instructor posts an announcement to your class.</div>
                    </div>
                    <div class="form-check form-switch ms-3 flex-shrink-0 mt-1">
                        <input asp-for="EmailOnAnnouncement" class="form-check-input" role="switch" />
                    </div>
                </div>

                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="fw-medium small">Class Status Updates</div>
                        <div class="text-muted" style="font-size:.8rem;">Receive an email when your submitted class is approved or rejected (instructors).</div>
                    </div>
                    <div class="form-check form-switch ms-3 flex-shrink-0 mt-1">
                        <input asp-for="EmailOnClassStatus" class="form-check-input" role="switch" />
                    </div>
                </div>

                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="fw-medium small">Application Status</div>
                        <div class="text-muted" style="font-size:.8rem;">Receive an email when your instructor application is reviewed.</div>
                    </div>
                    <div class="form-check form-switch ms-3 flex-shrink-0 mt-1">
                        <input asp-for="EmailOnApplicationStatus" class="form-check-input" role="switch" />
                    </div>
                </div>

                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="fw-medium small">Password Changes <span class="badge bg-secondary ms-1" style="font-size:.65rem;">Security</span></div>
                        <div class="text-muted" style="font-size:.8rem;">Always receive an email when your password is changed.</div>
                    </div>
                    <div class="form-check form-switch ms-3 flex-shrink-0 mt-1">
                        <input asp-for="EmailOnPasswordChange" class="form-check-input" role="switch" />
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            @* ── In-app notifications ──────────────────────────────── *@
            <h6 class="fw-semibold text-uppercase text-muted small mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-bell fa-sm"></i> In-App Notifications
            </h6>

            <div class="d-flex flex-column gap-3 mb-4 ps-1">

                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="fw-medium small">Enrollment Confirmed</div>
                        <div class="text-muted" style="font-size:.8rem;">Show a bell notification when you enroll in a class.</div>
                    </div>
                    <div class="form-check form-switch ms-3 flex-shrink-0 mt-1">
                        <input asp-for="InAppOnEnrollment" class="form-check-input" role="switch" />
                    </div>
                </div>

                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <div class="fw-medium small">Class Announcements</div>
                        <div class="text-muted" style="font-size:.8rem;">Show a bell notification for new announcements from your classes.</div>
                    </div>
                    <div class="form-check form-switch ms-3 flex-shrink-0 mt-1">
                        <input asp-for="InAppOnAnnouncement" class="form-check-input" role="switch" />
                    </div>
                </div>

            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-dark px-4">Save Preferences</button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
@if (TempData["SuccessMessage"] != null)
{
    <text>Swal.fire({ icon: 'success', title: 'Saved', text: '@TempData["SuccessMessage"]', position: 'top-end', timer: 3000, toast: true, timerProgressBar: true, showConfirmButton: false });</text>
}
@if (TempData["ErrorMessage"] != null)
{
    <text>Swal.fire({ icon: 'error', title: 'Error', text: '@TempData["ErrorMessage"]', position: 'top-end', timer: 5000, toast: true, timerProgressBar: true, showConfirmButton: false });</text>
}
</script>
}
