@model EliteAcademy.Web.ViewModels.Account.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/Account/_AccountSettingsLayout.cshtml";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-dark text-white fw-semibold d-flex align-items-center gap-2">
        <i class="fas fa-lock"></i> Change Password
    </div>
    <div class="card-body p-4">

        <p class="text-muted small mb-4">
            Choose a strong password. It must be at least 6 characters and include
            one uppercase letter and one special character.
        </p>

        <form asp-action="ChangePassword" asp-controller="Account" method="post"
              style="max-width:480px;">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label fw-medium small">Current Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-lock fa-sm text-muted"></i>
                    </span>
                    <input asp-for="CurrentPassword" id="currentPwd"
                           class="form-control border-start-0" placeholder="••••••••" />
                    <button type="button" class="input-group-text bg-light border-start-0"
                            onclick="togglePwd('currentPwd', this)" title="Show/hide">
                        <i class="fas fa-eye fa-sm text-muted"></i>
                    </button>
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-medium small">New Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-key fa-sm text-muted"></i>
                    </span>
                    <input asp-for="NewPassword" id="newPwd"
                           class="form-control border-start-0" placeholder="••••••••" />
                    <button type="button" class="input-group-text bg-light border-start-0"
                            onclick="togglePwd('newPwd', this)" title="Show/hide">
                        <i class="fas fa-eye fa-sm text-muted"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label fw-medium small">Confirm New Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fas fa-key fa-sm text-muted"></i>
                    </span>
                    <input asp-for="ConfirmNewPassword" id="confirmPwd"
                           class="form-control border-start-0" placeholder="••••••••" />
                    <button type="button" class="input-group-text bg-light border-start-0"
                            onclick="togglePwd('confirmPwd', this)" title="Show/hide">
                        <i class="fas fa-eye fa-sm text-muted"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4">Update Password</button>
                <a asp-controller="Account" asp-action="Profile"
                   class="btn btn-outline-secondary px-4">Cancel</a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
function togglePwd(id, btn) {
    const input = document.getElementById(id);
    const icon  = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
}
@if (TempData["SuccessMessage"] != null)
{
    <text>Swal.fire({ icon: 'success', title: 'Password Updated', text: '@TempData["SuccessMessage"]', position: 'top-end', timer: 4000, toast: true, timerProgressBar: true, showConfirmButton: false });</text>
}
@if (TempData["ErrorMessage"] != null)
{
    <text>Swal.fire({ icon: 'error', title: 'Failed', text: '@TempData["ErrorMessage"]', position: 'top-end', timer: 5000, toast: true, timerProgressBar: true, showConfirmButton: false });</text>
}
</script>
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
