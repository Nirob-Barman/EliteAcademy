@model EliteAcademy.Web.ViewModels.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/Account/_AuthLayout.cshtml";
}

<div class="auth-wrapper">

    @* ── Brand panel ─────────────────────────────────────────────────── *@
    <div class="col-lg-5 auth-brand-panel d-none d-lg-flex flex-column">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none mb-4">
            <div class="fw-bold fs-4 text-warning">&#9971; Elite Academy</div>
            <div class="text-white-50 small">Learn from the best, anywhere</div>
        </a>

        <h2 class="fw-bold text-white mb-2 lh-sm">Forgot your<br>password?</h2>
        <p class="text-white-50 mb-4" style="font-size:.92rem;">
            No worries. Enter your email and we'll send you a secure link
            to reset your password.
        </p>

        <div class="mb-2">
            <div class="auth-feature">
                <div class="auth-feature-icon"><i class="fas fa-envelope-open-text"></i></div>
                <div>
                    <div class="text-white fw-semibold" style="font-size:.88rem;">Check your inbox</div>
                    <div class="text-white-50" style="font-size:.78rem;">The reset link will arrive within a minute.</div>
                </div>
            </div>
            <div class="auth-feature">
                <div class="auth-feature-icon"><i class="fas fa-shield-halved"></i></div>
                <div>
                    <div class="text-white fw-semibold" style="font-size:.88rem;">Secure link</div>
                    <div class="text-white-50" style="font-size:.78rem;">The link expires in 24 hours for your security.</div>
                </div>
            </div>
        </div>
    </div>

    @* ── Form panel ──────────────────────────────────────────────────── *@
    <div class="col-12 col-lg-7 auth-form-panel">
        <div class="auth-form-inner">

            <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-lg-none d-block mb-4">
                <span class="fw-bold fs-5">&#9971; Elite Academy</span>
            </a>

            <a asp-action="Login" asp-controller="Account" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-4">
                <i class="fas fa-arrow-left fa-xs"></i> Back to sign in
            </a>

            <h3 class="fw-bold mb-1">Reset your password</h3>
            <p class="text-muted mb-4" style="font-size:.9rem;">
                Enter the email address linked to your account and we'll send a reset link.
            </p>

            <form asp-action="ForgotPassword" asp-controller="Account" method="post">

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-medium small mb-1">Email address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope fa-sm"></i></span>
                        <input asp-for="Email" class="form-control input-icon" placeholder="you@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="d-grid mb-4">
                    <button type="submit" class="btn btn-auth">Send Reset Link</button>
                </div>

                <p class="text-center text-muted small mb-0">
                    Remembered it?
                    <a asp-action="Login" asp-controller="Account" class="fw-semibold text-dark text-decoration-none">Sign in &rarr;</a>
                </p>

            </form>
        </div>
    </div>

</div>

@section Scripts {
<script>
@if (TempData["SuccessMessage"] != null)
{
    <text>Swal.fire({ icon: 'success', title: 'Email Sent', text: '@TempData["SuccessMessage"]', position: 'top-end', timer: 6000, toast: true, timerProgressBar: true, showConfirmButton: false });</text>
}
@if (TempData["ErrorMessage"] != null)
{
    <text>Swal.fire({ icon: 'error', title: 'Error', text: '@TempData["ErrorMessage"]', position: 'top-end', timer: 5000, toast: true, timerProgressBar: true, showConfirmButton: false });</text>
}
</script>
}
