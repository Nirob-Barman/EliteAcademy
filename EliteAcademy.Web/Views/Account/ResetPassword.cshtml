@model EliteAcademy.Web.ViewModels.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/Account/_AuthLayout.cshtml";
}

<div class="auth-wrapper">

    @* ── Brand panel ─────────────────────────────────────────────────── *@
    <div class="col-lg-5 auth-brand-panel d-none d-lg-flex flex-column">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none mb-4">
            <div class="fw-bold fs-4 text-warning">&#9971; Elite Academy</div>
            <div class="text-white-50 small">Learn from the best, anywhere</div>
        </a>

        <h2 class="fw-bold text-white mb-2 lh-sm">Create a new<br>password</h2>
        <p class="text-white-50 mb-4" style="font-size:.92rem;">
            Choose a strong password to keep your account secure.
        </p>

        <div class="mb-2">
            <div class="auth-feature">
                <div class="auth-feature-icon"><i class="fas fa-key"></i></div>
                <div>
                    <div class="text-white fw-semibold" style="font-size:.88rem;">Strong password tips</div>
                    <div class="text-white-50" style="font-size:.78rem;">Use at least 6 characters with uppercase and a special character.</div>
                </div>
            </div>
            <div class="auth-feature">
                <div class="auth-feature-icon"><i class="fas fa-lock"></i></div>
                <div>
                    <div class="text-white fw-semibold" style="font-size:.88rem;">One-time link</div>
                    <div class="text-white-50" style="font-size:.78rem;">This reset link can only be used once and expires in 24 hours.</div>
                </div>
            </div>
        </div>
    </div>

    @* ── Form panel ──────────────────────────────────────────────────── *@
    <div class="col-12 col-lg-7 auth-form-panel">
        <div class="auth-form-inner">

            <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-lg-none d-block mb-4">
                <span class="fw-bold fs-5">&#9971; Elite Academy</span>
            </a>

            <h3 class="fw-bold mb-1">Set new password</h3>
            <p class="text-muted mb-4" style="font-size:.9rem;">Your new password must be different from previous ones.</p>

            <form asp-action="ResetPassword" asp-controller="Account" method="post">
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-medium small mb-1">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock fa-sm"></i></span>
                        <input asp-for="Password" id="newPassword" class="form-control input-icon" placeholder="••••••••" />
                        <button type="button" class="input-group-text password-toggle" onclick="togglePwd('newPassword', this)">
                            <i class="fas fa-eye fa-sm"></i>
                        </button>
                    </div>
                    <div class="text-muted mt-1" style="font-size:.75rem;">Min 6 chars, 1 uppercase, 1 special character</div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-medium small mb-1">Confirm Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock fa-sm"></i></span>
                        <input asp-for="ConfirmPassword" id="confirmPassword" class="form-control input-icon" placeholder="••••••••" />
                        <button type="button" class="input-group-text password-toggle" onclick="togglePwd('confirmPassword', this)">
                            <i class="fas fa-eye fa-sm"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid mb-4">
                    <button type="submit" class="btn btn-auth">Reset Password</button>
                </div>

                <p class="text-center text-muted small mb-0">
                    <a asp-action="Login" asp-controller="Account" class="fw-semibold text-dark text-decoration-none">&larr; Back to sign in</a>
                </p>

            </form>
        </div>
    </div>

</div>

@section Scripts {
<script>
@if (TempData["ErrorMessage"] != null)
{
    <text>Swal.fire({ icon: 'error', title: 'Reset Failed', text: '@TempData["ErrorMessage"]', position: 'top-end', timer: 5000, toast: true, timerProgressBar: true, showConfirmButton: false });</text>
}
function togglePwd(id, btn) {
    const input = document.getElementById(id);
    const icon  = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
}
</script>
}
