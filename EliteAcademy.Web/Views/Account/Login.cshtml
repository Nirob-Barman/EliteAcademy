@model EliteAcademy.Web.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/Account/_AuthLayout.cshtml";
}

<div class="auth-wrapper">

    @* ── Brand panel (desktop only) ──────────────────────────────────── *@
    <div class="col-lg-5 auth-brand-panel d-none d-lg-flex flex-column">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none mb-4">
            <div class="fw-bold fs-4 text-warning">&#9971; Elite Academy</div>
            <div class="text-white-50 small">Learn from the best, anywhere</div>
        </a>

        <h2 class="fw-bold text-white mb-2 lh-sm">Advance your<br>career today</h2>
        <p class="text-white-50 mb-4" style="font-size:.92rem;">
            Join thousands of learners already growing their skills
            through expert-led, practical classes.
        </p>

        <div class="mb-4">
            <div class="auth-feature">
                <div class="auth-feature-icon"><i class="fas fa-chalkboard-teacher"></i></div>
                <div>
                    <div class="text-white fw-semibold" style="font-size:.88rem;">Expert Instructors</div>
                    <div class="text-white-50" style="font-size:.78rem;">Vetted professionals with real-world experience.</div>
                </div>
            </div>
            <div class="auth-feature">
                <div class="auth-feature-icon"><i class="fas fa-calendar-check"></i></div>
                <div>
                    <div class="text-white fw-semibold" style="font-size:.88rem;">Flexible Enrollment</div>
                    <div class="text-white-50" style="font-size:.78rem;">No fixed dates — learn at your own pace.</div>
                </div>
            </div>
            <div class="auth-feature">
                <div class="auth-feature-icon"><i class="fas fa-star"></i></div>
                <div>
                    <div class="text-white fw-semibold" style="font-size:.88rem;">Verified Reviews</div>
                    <div class="text-white-50" style="font-size:.78rem;">Honest peer ratings to guide your choice.</div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-4 pt-3 border-top border-white border-opacity-10">
            <div class="auth-stat">
                <div class="auth-stat-number">500+</div>
                <div class="auth-stat-label">Students</div>
            </div>
            <div class="auth-stat">
                <div class="auth-stat-number">50+</div>
                <div class="auth-stat-label">Classes</div>
            </div>
            <div class="auth-stat">
                <div class="auth-stat-number">20+</div>
                <div class="auth-stat-label">Instructors</div>
            </div>
        </div>
    </div>

    @* ── Form panel ──────────────────────────────────────────────────── *@
    <div class="col-12 col-lg-7 auth-form-panel">
        <div class="auth-form-inner">

            @* Mobile brand *@
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-lg-none d-block mb-4">
                <span class="fw-bold fs-5">&#9971; Elite Academy</span>
            </a>

            <h3 class="fw-bold mb-1">Welcome back</h3>
            <p class="text-muted mb-4" style="font-size:.9rem;">Sign in to continue to your account</p>

            <form asp-action="Login" asp-controller="Account" method="post">

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-medium small mb-1">Email address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope fa-sm"></i></span>
                        <input asp-for="Email" class="form-control input-icon" placeholder="you@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label fw-medium small mb-0">Password</label>
                        <a asp-action="ForgotPassword" asp-controller="Account" class="small text-muted text-decoration-none">Forgot password?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock fa-sm"></i></span>
                        <input asp-for="Password" id="loginPassword" class="form-control input-icon" placeholder="••••••••" />
                        <button type="button" class="input-group-text password-toggle" onclick="togglePwd('loginPassword', this)">
                            <i class="fas fa-eye fa-sm"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small text-muted">Keep me signed in</label>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-auth">Sign In</button>
                </div>

                <div class="auth-divider">or continue with</div>

                <div class="d-flex gap-2 mb-4">
                    <button type="button" class="btn btn-social flex-fill" onclick="showDevAlert('Google')">
                        <i class="fab fa-google me-2" style="color:#EA4335;"></i>Google
                    </button>
                    <button type="button" class="btn btn-social flex-fill" onclick="showDevAlert('Facebook')">
                        <i class="fab fa-facebook me-2" style="color:#1877F2;"></i>Facebook
                    </button>
                </div>

                <p class="text-center text-muted small mb-0">
                    Don't have an account?
                    <a asp-action="Register" asp-controller="Account" class="fw-semibold text-dark text-decoration-none">Create one free &rarr;</a>
                </p>

            </form>
        </div>
    </div>

</div>

@section Scripts {
<script>
@if (TempData["SuccessMessage"] != null)
{
    <text>Swal.fire({ icon: 'success', title: 'Success', text: '@TempData["SuccessMessage"]', position: 'top-end', timer: 4000, toast: true, timerProgressBar: true, showConfirmButton: false });</text>
}
@if (TempData["ErrorMessage"] != null)
{
    <text>Swal.fire({ icon: 'error', title: 'Login Failed', text: '@TempData["ErrorMessage"]', position: 'top-end', timer: 5000, toast: true, timerProgressBar: true, showConfirmButton: false });</text>
}
function togglePwd(id, btn) {
    const input = document.getElementById(id);
    const icon  = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
}
function showDevAlert(p) {
    Swal.fire({ icon: 'info', title: 'Coming Soon', text: p + ' login is under development.', confirmButtonColor: '#212529' });
}
</script>
}
