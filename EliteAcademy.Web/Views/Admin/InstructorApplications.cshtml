@model List<EliteAcademy.Application.DTOs.InstructorApplication.InstructorApplicationDto>
@using EliteAcademy.Domain.Enums

@{
    ViewData["Title"] = "Instructor Applications";
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";

    var pending  = Model.Count(a => a.Status == InstructorApplicationStatus.Pending);
    var approved = Model.Count(a => a.Status == InstructorApplicationStatus.Approved);
    var rejected = Model.Count(a => a.Status == InstructorApplicationStatus.Rejected);
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h2 class="fw-bold mb-0">Instructor Applications</h2>
    <div class="d-flex gap-2">
        <span class="badge bg-warning text-dark fs-6">@pending Pending</span>
        <span class="badge bg-success fs-6">@approved Approved</span>
        <span class="badge bg-danger fs-6">@rejected Rejected</span>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fa-solid fa-file-circle-question fa-3x text-muted mb-3"></i>
        <h5 class="fw-semibold">No Instructor Applications Yet</h5>
        <p class="text-muted mb-0">When students apply to become instructors, their applications will appear here.</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Applicant</th>
                        <th>Email</th>
                        <th>Expertise</th>
                        <th>Applied</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var app in Model)
                    {
                        var rowClass   = app.Status == InstructorApplicationStatus.Approved ? "table-success"
                                       : app.Status == InstructorApplicationStatus.Rejected ? "table-danger"
                                       : "";
                        var badgeClass = app.Status == InstructorApplicationStatus.Pending  ? "bg-warning text-dark"
                                       : app.Status == InstructorApplicationStatus.Approved ? "bg-success"
                                       : app.Status == InstructorApplicationStatus.Rejected ? "bg-danger"
                                       : "bg-secondary";
                        <tr class="@rowClass">
                            <td class="text-muted">@(i++)</td>
                            <td class="fw-semibold">@app.FullName</td>
                            <td>@app.Email</td>
                            <td>@app.Expertise</td>
                            <td class="small text-muted">@app.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                <span class="badge @badgeClass">@app.Status</span>
                            </td>
                            <td class="text-center">
                                @if (app.Status == InstructorApplicationStatus.Pending)
                                {
                                    <div class="d-flex gap-1 justify-content-center flex-wrap">

                                        @* Detail popover trigger *@
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                data-bs-toggle="modal"
                                                data-bs-target="#detailModal-@app.Id">
                                            View
                                        </button>

                                        @* Approve *@
                                        <form asp-action="ApproveApplication" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@app.Id" />
                                            <button type="button" class="btn btn-sm btn-success swal-confirm-btn"
                                                    data-swal-text="Approve @app.FullName as Instructor?">
                                                Approve
                                            </button>
                                        </form>

                                        @* Reject *@
                                        <button type="button" class="btn btn-sm btn-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#rejectModal-@app.Id">
                                            Reject
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#detailModal-@app.Id">
                                        View
                                    </button>
                                }
                            </td>
                        </tr>


                        @* Detail modal *@
                        <div class="modal fade" id="detailModal-@app.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Application — @app.FullName</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <dl class="row">
                                            <dt class="col-sm-3">Email</dt>
                                            <dd class="col-sm-9">@app.Email</dd>

                                            <dt class="col-sm-3">Expertise</dt>
                                            <dd class="col-sm-9">@app.Expertise</dd>

                                            <dt class="col-sm-3">About</dt>
                                            <dd class="col-sm-9" style="white-space:pre-wrap">@app.Bio</dd>

                                            <dt class="col-sm-3">Motivation</dt>
                                            <dd class="col-sm-9" style="white-space:pre-wrap">@app.Motivation</dd>

                                            @if (!string.IsNullOrWhiteSpace(app.AdminNotes))
                                            {
                                                <dt class="col-sm-3">Admin Notes</dt>
                                                <dd class="col-sm-9 text-danger">@app.AdminNotes</dd>
                                            }
                                        </dl>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Reject modal *@
                        @if (app.Status == InstructorApplicationStatus.Pending)
                        {
                            <div class="modal fade" id="rejectModal-@app.Id" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="RejectApplication" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ApplicationId" value="@app.Id" />
                                            <div class="modal-header">
                                                <h5 class="modal-title">Reject — @app.FullName</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <label class="form-label fw-semibold">
                                                    Reason / Feedback <span class="text-danger">*</span>
                                                </label>
                                                <textarea name="AdminNotes" class="form-control" rows="4"
                                                          placeholder="Explain why the application was not approved. This will be sent to the applicant."
                                                          required minlength="10"></textarea>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-danger">Reject Application</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.swal-confirm-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var form = btn.closest('form');
                Swal.fire({
                    title: 'Are you sure?',
                    text: btn.dataset.swalText,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, approve'
                }).then(function (result) {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}
