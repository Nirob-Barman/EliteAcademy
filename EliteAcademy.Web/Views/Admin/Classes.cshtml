@model EliteAcademy.Application.Wrappers.PagedResult<EliteAcademy.Application.DTOs.Class.ClassDto>
@using EliteAcademy.Domain.Enums

@{
    ViewData["Title"] = "Class Management";
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
}

<h2 class="mb-4 fw-bold">Class Management</h2>

@if (Model.Items.Any())
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Class Name</th>
                        <th>Instructor</th>
                        <th>Seats</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cls in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(cls.ClassImage))
                                {
                                    <img src="@cls.ClassImage" alt="@cls.ClassName"
                                         style="width:60px;height:45px;object-fit:cover;" class="rounded" />
                                }
                                else
                                {
                                    <span class="text-muted small">No image</span>
                                }
                            </td>
                            <td class="fw-semibold">@cls.ClassName</td>
                            <td>@cls.InstructorName</td>
                            <td>@cls.AvailableSeats</td>
                            <td class="fw-semibold">$@cls.Price.ToString("0.00")</td>
                            <td>
                                @{
                                    var badge = cls.Status switch
                                    {
                                        ClassStatus.Approved => "bg-success",
                                        ClassStatus.Rejected => "bg-danger",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @badge">@cls.Status</span>
                                @if (!string.IsNullOrWhiteSpace(cls.Feedback))
                                {
                                    <span class="ms-1" data-bs-toggle="tooltip" title="@cls.Feedback">&#128172;</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    @if (cls.Status != ClassStatus.Approved)
                                    {
                                        <form asp-action="ApproveClass" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@cls.Id" />
                                            <button type="button" class="btn btn-sm btn-success swal-confirm-btn"
                                                    data-swal-text="Approve &quot;@cls.ClassName&quot;?">
                                                Approve
                                            </button>
                                        </form>
                                    }
                                    @if (cls.Status != ClassStatus.Rejected)
                                    {
                                        <button type="button" class="btn btn-sm btn-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#rejectModal-@cls.Id">
                                            Reject
                                        </button>
                                    }
                                    <a asp-action="ClassEnrollments" asp-route-id="@cls.Id"
                                       class="btn btn-sm btn-outline-info">Enrollments</a>
                                </div>
                            </td>
                        </tr>

                        <div class="modal fade" id="rejectModal-@cls.Id" tabindex="-1"
                             aria-labelledby="rejectLabel-@cls.Id" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="RejectClass" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ClassId" value="@cls.Id" />
                                        <div class="modal-header">
                                            <h5 class="modal-title" id="rejectLabel-@cls.Id">
                                                Reject: @cls.ClassName
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <label class="form-label fw-semibold">Feedback <span class="text-danger">*</span></label>
                                            <textarea name="Feedback" class="form-control" rows="3"
                                                      placeholder="Provide feedback for the instructor..." required></textarea>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger">Reject Class</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_Pagination", new EliteAcademy.Web.ViewModels.Shared.PaginationViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        Action = "Classes"
    })
}
else
{
    <div class="text-center py-5">
        <i class="fa-solid fa-chalkboard fa-3x text-muted mb-3"></i>
        <h5 class="fw-semibold">No Classes Found</h5>
        <p class="text-muted mb-0">Classes submitted by instructors for approval will appear here.</p>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
            new bootstrap.Tooltip(el);
        });

        document.querySelectorAll('.swal-confirm-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var form = btn.closest('form');
                Swal.fire({
                    title: 'Are you sure?',
                    text: btn.dataset.swalText,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, approve'
                }).then(function (result) {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}
