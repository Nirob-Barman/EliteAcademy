<footer class="bg-dark text-light mt-5 pt-5 pb-3">
    <div class="container text-center">
        <div class="row g-4 text-start">
            <div class="col-12 col-md-6 col-lg-4">
                <h5 class="fw-bold text-warning mb-3">&#9971; Elite Academy</h5>
                <p class="text-light-emphasis mb-0">
                    A modern learning platform connecting students with expert instructors through practical, career-focused classes.
                </p>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <h6 class="text-uppercase fw-semibold mb-3">Explore</h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><a class="text-decoration-none text-light-emphasis" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="mb-2"><a class="text-decoration-none text-light-emphasis" asp-controller="Classes" asp-action="Index">Classes</a></li>
                    <li class="mb-2"><a class="text-decoration-none text-light-emphasis" asp-controller="Instructors" asp-action="Index">Instructors</a></li>
                    <li><a class="text-decoration-none text-light-emphasis" asp-controller="About" asp-action="Index">About</a></li>
                </ul>
            </div>
            <div class="col-6 col-md-3 col-lg-3">
                <h6 class="text-uppercase fw-semibold mb-3">Account</h6>
                <ul class="list-unstyled mb-0">
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <li class="mb-2"><a class="text-decoration-none text-light-emphasis" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li><a class="text-decoration-none text-light-emphasis" asp-controller="Classes" asp-action="Index">Browse Classes</a></li>
                    }
                    else
                    {
                        <li class="mb-2"><a class="text-decoration-none text-light-emphasis" asp-controller="Account" asp-action="Login">Login</a></li>
                        <li><a class="text-decoration-none text-light-emphasis" asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
            <div class="col-12 col-lg-3">
                <h6 class="text-uppercase fw-semibold mb-3">Contact</h6>
                <ul class="list-unstyled text-light-emphasis mb-0">
                    <li class="mb-2">support@eliteacademy.com</li>
                    <li class="mb-2">+1 (800) 555-0123</li>
                    <li>Mon - Fri, 9:00 AM - 6:00 PM</li>
                </ul>
            </div>
        </div>
        <hr class="border-secondary my-4" />
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 text-light-emphasis small">
            <p class="mb-0">&copy; @DateTime.Now.Year Elite Academy. All rights reserved.</p>
            <div class="d-flex gap-3">
                <a class="text-decoration-none text-light-emphasis" asp-controller="Home" asp-action="Privacy">Privacy</a>
                <a class="text-decoration-none text-light-emphasis" asp-controller="About" asp-action="Index">Terms</a>
            </div>
        </div>
    </div>
</footer>
