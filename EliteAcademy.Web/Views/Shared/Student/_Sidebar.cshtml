@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction     = ViewContext.RouteData.Values["action"]?.ToString();

    string NavClass(string controller, string action = "")
    {
        bool match = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
                  && (string.IsNullOrEmpty(action) ||
                      string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase));
        return match
            ? "nav-link px-3 py-2 rounded bg-primary text-white fw-semibold shadow-sm"
            : "nav-link text-light px-3 py-2 rounded";
    }
}

<div class="h-100 d-flex flex-column p-3 p-lg-4 text-light">

    @* Brand *@
    <a class="text-decoration-none text-white d-block mb-4" asp-controller="Home" asp-action="Index">
        <div class="fw-bold fs-5">
            &#9971; Elite Academy
            <span class="badge bg-primary-subtle text-primary ms-1">Student</span>
        </div>
        <div class="small text-light-emphasis mt-1">Learning portal</div>
    </a>

    @* Nav *@
    <nav class="nav flex-column gap-1">

        <div class="text-uppercase text-light-emphasis small px-3 mb-1" style="font-size:.7rem;letter-spacing:.06em;">
            My Learning
        </div>
        <a class="@NavClass("Student", "Dashboard")"
           asp-controller="Student" asp-action="Dashboard">
           <i class="fas fa-home fa-sm me-2"></i>Dashboard
        </a>
        <a class="@NavClass("Student", "EnrolledClasses")"
           asp-controller="Student" asp-action="EnrolledClasses">
           <i class="fas fa-graduation-cap fa-sm me-2"></i>My Classes
        </a>
        <a class="@NavClass("Student", "Cart")"
           asp-controller="Student" asp-action="Cart">
           <i class="fas fa-cart-shopping fa-sm me-2"></i>My Cart
        </a>
        <a class="@NavClass("Student", "Wishlist")"
           asp-controller="Student" asp-action="Wishlist">
           <i class="fas fa-heart fa-sm me-2"></i>Wishlist
        </a>

        <div class="text-uppercase text-light-emphasis small px-3 mt-3 mb-1" style="font-size:.7rem;letter-spacing:.06em;">
            Explore
        </div>
        <a class="@NavClass("Classes", "Index")"
           asp-controller="Classes" asp-action="Index">
           <i class="fas fa-th-large fa-sm me-2"></i>Browse Classes
        </a>
        <a class="@NavClass("Notification", "Index")"
           asp-controller="Notification" asp-action="Index">
            <i class="fas fa-bell fa-sm me-2"></i>Notifications
            <span id="notif-badge-sidebar"
                  class="badge bg-danger ms-auto"
                  style="display:none;font-size:.65rem;"></span>
        </a>
        <a class="@NavClass("InstructorApplication")"
           asp-controller="InstructorApplication" asp-action="MyApplication">
           <i class="fas fa-chalkboard-teacher fa-sm me-2"></i>Become Instructor
        </a>

    </nav>

    @* Footer *@
    <div class="mt-auto pt-4 border-top border-secondary-subtle">
        <div class="small text-light-emphasis">Signed in as</div>
        <div class="fw-semibold text-truncate mb-2">@User.Identity!.Name</div>
        <div class="d-flex gap-2">
            <a asp-controller="Account" asp-action="Profile"
               class="btn btn-sm btn-outline-light flex-fill text-center" style="font-size:.8rem;">
                <i class="fas fa-user fa-xs me-1"></i>Profile
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 flex-fill">
                <button type="submit" class="btn btn-sm btn-outline-danger w-100" style="font-size:.8rem;">
                    <i class="fas fa-sign-out-alt fa-xs me-1"></i>Logout
                </button>
            </form>
        </div>
    </div>

</div>
