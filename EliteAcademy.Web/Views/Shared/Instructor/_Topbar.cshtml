<div class="container-fluid py-3 px-3 px-lg-4 d-flex justify-content-between align-items-center gap-3">
    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-outline-dark d-lg-none" type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#instructorSidebarMobile"
                aria-controls="instructorSidebarMobile"
                aria-label="Open instructor navigation">
            <span class="fw-semibold">Menu</span>
        </button>

        <div>
            <div class="small text-muted text-uppercase">Instructor Workspace</div>
            <div class="fw-semibold fs-5">@ViewData["Title"]</div>
        </div>
    </div>

    <div class="d-flex align-items-center gap-3">
        <a class="position-relative text-dark text-decoration-none fs-5"
           asp-controller="Notification" asp-action="Index" title="Notifications">
            &#128276;
            <span id="notif-badge-instructor"
                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                  style="display:none;font-size:0.65rem;"></span>
        </a>
    </div>
    <div class="dropdown">
        <a class="btn btn-outline-secondary dropdown-toggle" href="#" role="button"
           data-bs-toggle="dropdown" aria-expanded="false">
            @User.Identity!.Name
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">Profile</a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger">Logout</button>
                </form>
            </li>
        </ul>
    </div>
</div>
