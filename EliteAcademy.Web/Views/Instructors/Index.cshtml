@model List<EliteAcademy.Application.DTOs.Instructor.InstructorProfileDto>

@{
    ViewData["Title"] = "Our Instructors";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="py-4">
    <h1 class="fw-bold mb-2">Our Instructors</h1>
    <p class="text-muted lead">Meet the experts behind our world-class training programs.</p>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var instructor in Model)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card shadow-sm h-100 text-center">
                    <div class="card-body py-4">
                        @if (!string.IsNullOrWhiteSpace(instructor.ImageUrl))
                        {
                            <img src="@instructor.ImageUrl" alt="@instructor.FirstName @instructor.LastName"
                                 class="rounded-circle mb-3"
                                 style="width:90px;height:90px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center mb-3"
                                 style="width:90px;height:90px;">
                                <span class="text-white fs-3">
                                    @(instructor.FirstName?.Substring(0, 1).ToUpper())
                                </span>
                            </div>
                        }
                        <h5 class="fw-bold mb-1">@instructor.FirstName @instructor.LastName</h5>
                        <p class="text-muted small mb-3">@instructor.Email</p>
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            @if (instructor.ClassCount > 0)
                            {
                                <span class="badge bg-dark-subtle text-dark">
                                    &#9971; @instructor.ClassCount @(instructor.ClassCount == 1 ? "class" : "classes")
                                </span>
                            }
                            @if (instructor.StudentCount > 0)
                            {
                                <span class="badge bg-primary-subtle text-primary">
                                    &#128100; @instructor.StudentCount @(instructor.StudentCount == 1 ? "student" : "students")
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fa-solid fa-person-chalkboard fa-3x text-muted mb-3"></i>
        <h5 class="fw-semibold">No Instructors Yet</h5>
        <p class="text-muted mb-0">Check back soon — our team is growing!</p>
    </div>
}

<div class="text-center mt-5">
    <a asp-controller="Classes" asp-action="Index" class="btn btn-dark">Browse Classes</a>
</div>
