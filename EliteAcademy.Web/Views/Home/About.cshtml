@{
    ViewData["Title"] = "About Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="py-4">
    <h1 class="fw-bold mb-3">About Elite Academy</h1>
    <p class="lead text-muted">
        Elite Academy is a premier sports training platform dedicated to helping athletes of all levels
        reach their full potential through structured, expert-led programs.
    </p>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">&#127919; Our Mission</h4>
                <p class="text-muted">
                    To provide accessible, high-quality sports education that empowers students to
                    achieve excellence — both on and off the field.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3">&#128161; Our Vision</h4>
                <p class="text-muted">
                    To be the most trusted online sports academy, connecting passionate learners
                    with world-class instructors across all disciplines.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="bg-light rounded-3 p-4 mb-5">
    <h4 class="fw-bold mb-3">What We Offer</h4>
    <ul class="list-unstyled row g-2">
        <li class="col-md-6"><span class="text-success me-2">&#10003;</span> Instructor-led live classes</li>
        <li class="col-md-6"><span class="text-success me-2">&#10003;</span> Flexible enrollment and scheduling</li>
        <li class="col-md-6"><span class="text-success me-2">&#10003;</span> Structured training programs</li>
        <li class="col-md-6"><span class="text-success me-2">&#10003;</span> Progress tracking dashboard</li>
        <li class="col-md-6"><span class="text-success me-2">&#10003;</span> Secure online payments</li>
        <li class="col-md-6"><span class="text-success me-2">&#10003;</span> Community of dedicated athletes</li>
    </ul>
</div>

<div class="text-center py-3">
    <a asp-controller="Classes" asp-action="Index"   class="btn btn-dark me-2">Browse Classes</a>
    <a asp-controller="Instructors" asp-action="Index" class="btn btn-outline-dark">Meet Our Instructors</a>
</div>
