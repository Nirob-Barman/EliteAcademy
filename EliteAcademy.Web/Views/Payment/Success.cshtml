@{
    ViewData["Title"] = "Payment Successful";
    Layout = "~/Views/Shared/Student/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5 text-center py-5">

        <div class="mb-4">
            <span style="font-size:4rem;color:#198754;">&#10003;</span>
        </div>

        <h2 class="fw-bold text-success mb-2">Payment Successful!</h2>
        <p class="text-muted mb-4">
            You have been enrolled. Check your email for a confirmation message.
        </p>

        <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
            <a asp-controller="Student" asp-action="EnrolledClasses" class="btn btn-success btn-lg px-5">
                Go to My Classes
            </a>
            <a asp-controller="Classes" asp-action="Index" class="btn btn-outline-primary btn-lg">
                Browse More Classes
            </a>
        </div>

    </div>
</div>
