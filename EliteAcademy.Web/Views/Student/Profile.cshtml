@model EliteAcademy.Web.ViewModels.Student.StudentProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/Student/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white fw-semibold">My Profile</div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(Model.ExistingPhotoUrl))
                {
                    <div class="text-center mb-3">
                        <img src="@Model.ExistingPhotoUrl" alt="Profile photo"
                             class="rounded-circle border shadow-sm"
                             style="width:100px;height:100px;object-fit:cover;" />
                    </div>
                }

                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input asp-for="ExistingPhotoUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="FirstName" class="form-label fw-semibold">First Name</label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LastName" class="form-label fw-semibold">Last Name</label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email</label>
                        <input asp-for="Email" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhotoFile" class="form-label fw-semibold">Profile Photo</label>
                        <input asp-for="PhotoFile" type="file" class="form-control" accept="image/*" />
                        <div class="text-muted small mt-1">Leave blank to keep current photo.</div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
