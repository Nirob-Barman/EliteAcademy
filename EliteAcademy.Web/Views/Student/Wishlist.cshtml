@model List<EliteAcademy.Application.DTOs.Wishlist.WishlistDto>

@{
    ViewData["Title"] = "My Wishlist";
    Layout = "~/Views/Shared/Student/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">My Wishlist</h4>
        @if (Model != null && Model.Any())
        {
            <span class="text-muted small">@Model.Count saved class@(Model.Count == 1 ? "" : "es")</span>
        }
    </div>
    <a asp-controller="Classes" asp-action="Index"
       class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
        <i class="fas fa-arrow-left fa-xs"></i> Browse Classes
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">

                    @* Thumbnail *@
                    @if (!string.IsNullOrWhiteSpace(item.ClassImage))
                    {
                        <img src="@item.ClassImage" class="card-img-top" alt="@item.ClassName"
                             style="height:160px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center"
                             style="height:160px;">
                            <i class="fas fa-chalkboard-teacher fa-2x text-muted opacity-50"></i>
                        </div>
                    }

                    <div class="card-body d-flex flex-column p-3">
                        <h6 class="fw-semibold mb-1 lh-sm">@item.ClassName</h6>
                        <div class="text-muted small mb-2">@item.InstructorName</div>

                        <div class="d-flex align-items-center justify-content-between mb-3 mt-auto">
                            <span class="fw-bold">$@item.Price.ToString("0.00")</span>
                            @if (item.AvailableSeats == 0)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">Full</span>
                            }
                            else
                            {
                                <span class="text-muted small">@item.AvailableSeats seat@(item.AvailableSeats == 1 ? "" : "s") left</span>
                            }
                        </div>

                        <div class="d-flex gap-2">
                            @if (item.AvailableSeats > 0)
                            {
                                <button class="btn btn-dark btn-sm flex-grow-1 select-from-wishlist-btn"
                                        data-class-id="@item.ClassId">
                                    <i class="fas fa-cart-shopping fa-xs me-1"></i>Add to Cart
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm flex-grow-1" disabled>
                                    <i class="fas fa-ban fa-xs me-1"></i>Unavailable
                                </button>
                            }
                            <form asp-action="RemoveFromWishlist" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                        title="Remove from wishlist">
                                    <i class="fas fa-heart-crack fa-xs"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 my-4">
        <div class="mb-3" style="font-size:3rem;color:#ced4da;">
            <i class="fas fa-heart"></i>
        </div>
        <h5 class="fw-semibold mb-2">Your wishlist is empty</h5>
        <p class="text-muted small mb-4">
            Save classes you're interested in and come back to them anytime.
        </p>
        <a asp-controller="Classes" asp-action="Index" class="btn btn-dark px-4">
            Browse Classes
        </a>
    </div>
}

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        $(document).ready(function () {
            $('.select-from-wishlist-btn').on('click', function () {
                var classId = $(this).data('class-id');
                var token   = $('input[name="__RequestVerificationToken"]:first').val();
                var btn     = $(this);
                $.ajax({
                    url: '/Student/SelectClass',
                    type: 'POST',
                    data: { classId: classId, __RequestVerificationToken: token },
                    success: function () {
                        Swal.fire({ icon: 'success', title: 'Added to Cart!', timer: 1800, showConfirmButton: false, toast: true, position: 'top-end' });
                        btn.html('<i class="fas fa-check fa-xs me-1"></i>In Cart')
                           .prop('disabled', true)
                           .removeClass('btn-dark').addClass('btn-secondary');
                    },
                    error: function (xhr) {
                        Swal.fire({ icon: 'error', title: 'Failed', text: xhr.responseText || 'Could not add to cart.' });
                    }
                });
            });
        });
    </script>
}
