@model EliteAcademy.Web.ViewModels.Coupon.CouponFormViewModel

<div class="mb-3">
    <label asp-for="Code" class="form-label fw-semibold"></label>
    <input asp-for="Code" class="form-control text-uppercase" placeholder="e.g. SUMMER20" />
    <span asp-validation-for="Code" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="DiscountPercent" class="form-label fw-semibold"></label>
    <div class="input-group">
        <input asp-for="DiscountPercent" class="form-control" type="number" min="1" max="100" step="0.01" />
        <span class="input-group-text">%</span>
    </div>
    <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="MaxUsages" class="form-label fw-semibold"></label>
    <input asp-for="MaxUsages" class="form-control" type="number" min="0" />
    <div class="form-text">Set to 0 for unlimited usages.</div>
    <span asp-validation-for="MaxUsages" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="ExpiresAt" class="form-label fw-semibold"></label>
    <input asp-for="ExpiresAt" class="form-control" type="datetime-local" />
    <span asp-validation-for="ExpiresAt" class="text-danger small"></span>
</div>

<div class="mb-3 form-check">
    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
    <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
</div>
