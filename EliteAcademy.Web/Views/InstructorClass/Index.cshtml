@model List<EliteAcademy.Application.DTOs.Class.ClassDto>
@using EliteAcademy.Domain.Enums

@{
    ViewData["Title"] = "My Classes";
    Layout = "~/Views/Shared/Instructor/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">My Classes</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Class</a>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Class Name</th>
                        <th>Status</th>
                        <th>Seats</th>
                        <th>Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cls in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(cls.ClassImage))
                                {
                                    <img src="@cls.ClassImage" alt="@cls.ClassName"
                                         style="width:60px;height:45px;object-fit:cover;" class="rounded" />
                                }
                                else
                                {
                                    <span class="text-muted small">No image</span>
                                }
                            </td>
                            <td class="fw-semibold">@cls.ClassName</td>
                            <td>
                                @{
                                    var badge = cls.Status switch
                                    {
                                        ClassStatus.Approved => "bg-success",
                                        ClassStatus.Rejected => "bg-danger",
                                        _                    => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @badge">@cls.Status</span>
                                @if (!string.IsNullOrWhiteSpace(cls.Feedback))
                                {
                                    <span class="ms-1" title="@cls.Feedback">&#128172;</span>
                                }
                            </td>
                            <td>@cls.AvailableSeats</td>
                            <td class="fw-semibold">$@cls.Price.ToString("0.00")</td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <a asp-action="Edit" asp-route-id="@cls.Id"
                                       class="btn btn-sm btn-outline-secondary">Edit</a>
                                    @if (cls.Status == ClassStatus.Approved)
                                    {
                                        <a asp-action="Students" asp-route-id="@cls.Id"
                                           class="btn btn-sm btn-outline-primary">Students</a>
                                        <a asp-action="Qa" asp-route-id="@cls.Id"
                                           class="btn btn-sm btn-outline-info">Q&amp;A</a>
                                        <a asp-action="Announcements" asp-route-id="@cls.Id"
                                           class="btn btn-sm btn-outline-warning">Announcements</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fa-solid fa-chalkboard fa-3x text-muted mb-3"></i>
        <h5 class="fw-semibold">No Classes Yet</h5>
        <p class="text-muted mb-4">Create your first class and submit it for admin approval.</p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Add Your First Class
        </a>
    </div>
}
