@model List<EliteAcademy.Application.DTOs.Payment.PaymentGatewayDto>

@{
    ViewData["Title"] = "Payment Gateways";
    Layout = "~/Views/Shared/Admin/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Payment Gateways</h2>
    <a asp-action="Create" class="btn btn-primary">+ Add Gateway</a>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Slug</th>
                        <th>Mode</th>
                        <th>Status</th>
                        <th>Transactions</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var gw in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@gw.Name</td>
                            <td><span class="badge bg-secondary font-monospace">@gw.Slug</span></td>
                            <td>
                                @if (gw.IsSandbox)
                                {
                                    <span class="badge bg-warning text-dark">Sandbox</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Live</span>
                                }
                            </td>
                            <td>
                                @if (gw.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@gw.TransactionCount</td>
                            <td class="text-muted small">@gw.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@gw.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>

                                    <form asp-action="Toggle" asp-route-id="@gw.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm @(gw.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                            @(gw.IsActive ? "Disable" : "Enable")
                                        </button>
                                    </form>

                                    <form asp-action="Delete" asp-route-id="@gw.Id" method="post" class="d-inline swal-confirm-form"
                                          data-swal-text="Delete this gateway? This cannot be undone.">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                @(gw.TransactionCount > 0 ? "disabled title=Cannot delete gateway with transactions" : "")>
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="fa-solid fa-credit-card fa-3x text-muted mb-3"></i>
        <h5 class="fw-semibold">No Payment Gateways Configured</h5>
        <p class="text-muted mb-4">Add a gateway to allow students to pay for class enrollments.</p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Add Your First Gateway
        </a>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.swal-confirm-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Delete Gateway?',
                    text: form.dataset.swalText,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete'
                }).then(function (result) {
                    if (result.isConfirmed) form.submit();
                });
            });
        });
    </script>
}
