@model EliteAcademy.Application.DTOs.InstructorApplication.InstructorApplicationDto?
@using EliteAcademy.Domain.Enums

@{
    ViewData["Title"] = "My Instructor Application";
    Layout = "~/Views/Shared/Student/_Layout.cshtml";

    string badgeClass   = "bg-secondary";
    string statusLabel  = "Unknown";
    string statusIcon   = "?";

    if (Model != null)
    {
        badgeClass  = Model.Status == InstructorApplicationStatus.Pending  ? "bg-warning text-dark"
                    : Model.Status == InstructorApplicationStatus.Approved ? "bg-success"
                    : "bg-danger";
        statusLabel = Model.Status == InstructorApplicationStatus.Pending  ? "Pending Review"
                    : Model.Status == InstructorApplicationStatus.Approved ? "Approved"
                    : "Not Approved";
        statusIcon  = Model.Status == InstructorApplicationStatus.Pending  ? "&#9203;"
                    : Model.Status == InstructorApplicationStatus.Approved ? "&#10003;"
                    : "&#10007;";
    }
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        @if (Model == null)
        {
            <div class="card shadow-sm text-center py-5">
                <div class="card-body">
                    <div class="fs-1 mb-3">&#127979;</div>
                    <h4 class="fw-bold">No Application Yet</h4>
                    <p class="text-muted">You haven't applied to become an instructor yet.</p>
                    <a asp-action="Apply" class="btn btn-dark px-4">Apply Now</a>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start justify-content-between mb-3 flex-wrap gap-2">
                        <h2 class="fw-bold mb-0">My Instructor Application</h2>
                        <span class="badge @badgeClass fs-6 px-3 py-2">@Html.Raw(statusIcon) &nbsp;@statusLabel</span>
                    </div>
                    <div class="text-muted small mb-4">Submitted: @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>

                    @if (Model.Status == InstructorApplicationStatus.Pending)
                    {
                        <div class="alert alert-info">
                            Your application is currently under review. We'll notify you by email and in-app notification once a decision has been made.
                        </div>
                    }

                    @if (Model.Status == InstructorApplicationStatus.Approved)
                    {
                        <div class="alert alert-success">
                            Congratulations! Your application was approved on <strong>@Model.ReviewedAt?.ToString("dd MMM yyyy")</strong>.
                            You are now an Instructor — please <strong>log out and log back in</strong> for your new role to take effect.
                        </div>
                    }

                    @if (Model.Status == InstructorApplicationStatus.Rejected)
                    {
                        <div class="alert alert-danger">
                            <strong>Feedback from admin:</strong><br />
                            @Model.AdminNotes
                        </div>
                        <p class="text-muted small">Reviewed on: @Model.ReviewedAt?.ToString("dd MMM yyyy")</p>
                        <a asp-action="Apply" class="btn btn-outline-dark btn-sm mb-4">Re-apply</a>
                    }

                    <hr />

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Area of Expertise</dt>
                        <dd class="col-sm-8">@Model.Expertise</dd>

                        <dt class="col-sm-4">About You</dt>
                        <dd class="col-sm-8" style="white-space:pre-wrap">@Model.Bio</dd>

                        <dt class="col-sm-4">Why Teach?</dt>
                        <dd class="col-sm-8" style="white-space:pre-wrap">@Model.Motivation</dd>
                    </dl>
                </div>
            </div>

            <a asp-controller="Student" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">&#8592; Back to Dashboard</a>
        }

    </div>
</div>
